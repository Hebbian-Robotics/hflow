{
  "name": "hflow-workspace-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only workspace UI for hflow catalogs (M0). Served by the hflow-ui FastAPI package.",
  "license": "Apache-2.0",
